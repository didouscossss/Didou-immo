rules_version = '2';

// Règles de sécurité Firestore pour Didou Immo — à coller dans
// Firebase Console → Firestore Database → Règles (ou déployer via la CLI
// Firebase). Sans elles, Firestore refuse tout accès par défaut : rien ne
// fonctionnera (comptes, biens enregistrés, parrainage...) tant que ce
// fichier n'est pas publié sur le projet.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      // Un compte peut modifier son propre document, mais jamais les champs
      // qui débloquent l'accès payant ou l'administration lui-même : ça,
      // c'est le rôle d'une Cloud Function (paiement vérifié via RTDN) ou
      // d'un admin (isAdmin activé manuellement depuis la console).
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isSubscribed', 'grantedFree', 'isAdmin']);

      match /properties/{propertyId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /referralCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn(); // incrémente `timesUsed` quand un filleul l'utilise
    }

    match /accessCodes/{code} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn(); // décrémente `usesRemaining` lors de la redemption
    }

    match /suggestions/{suggestionId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if false; // consultées uniquement depuis la console Firebase
    }
  }
}
