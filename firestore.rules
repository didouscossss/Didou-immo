rules_version = '2';

// Règles de sécurité Firestore pour Didou Immo — à coller dans
// Firebase Console → Firestore Database → Règles (ou déployer via la CLI
// Firebase). Sans elles, Firestore refuse tout accès par défaut : rien ne
// fonctionnera (comptes, biens enregistrés, parrainage...) tant que ce
// fichier n'est pas publié sur le projet.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Validation légitime d'un code cadeau : seuls `grantedFree` et
    // `grantedFreeVia` changent, et le code visé existe, est actif et a
    // encore des utilisations. `get()` lit l'état du code AVANT cette
    // transaction (y compris la décrémentation de `usesRemaining` faite en
    // parallèle sur accessCodes/{code} dans la même transaction), donc ce
    // contrôle reste correct même si le compte utilise deux codes en
    // parallèle par accident.
    function isRedeemingValidAccessCode() {
      let code = request.resource.data.grantedFreeVia;
      let codeDoc = get(/databases/$(database)/documents/accessCodes/$(code));
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['grantedFree', 'grantedFreeVia']) &&
        request.resource.data.grantedFree == true &&
        codeDoc.data.active == true &&
        codeDoc.data.usesRemaining > 0;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      // Un compte peut modifier son propre document, mais jamais les champs
      // qui débloquent l'accès payant ou l'administration lui-même, ni ceux
      // du parrainage — sauf le cas précis, vérifié ci-dessus, d'une
      // validation de code cadeau légitime. `pendingBonusDays`/`referredBy`
      // ne sont écrits que par la Cloud Function `applyReferralCode` (voir
      // functions/index.js), qui tourne en admin et contourne ces règles —
      // elle seule peut créditer le compte d'un AUTRE utilisateur (le
      // parrain), ce qu'un client ne peut jamais faire de façon sûre.
      allow update: if isOwner(uid) && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isSubscribed', 'grantedFree', 'isAdmin', 'pendingBonusDays', 'referredBy']) ||
        isRedeemingValidAccessCode()
      );

      match /properties/{propertyId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /referralCodes/{code} {
      // `get` seulement (pas `list`) : le code est toujours lu par son ID
      // exact (voir referral_service.dart), jamais par requête filtrée.
      // Avec `read`, n'importe quel compte connecté aurait pu lister TOUTE
      // la collection et récupérer chaque code de parrainage + son
      // `ownerUid` d'un coup.
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // `timesUsed` n'est incrémenté que par la Cloud Function
      // `applyReferralCode` (admin, contourne ces règles).
      allow update: if false;
    }

    match /accessCodes/{code} {
      // `get` seulement (pas `list`) : idem, un code cadeau n'est jamais lu
      // que par son ID exact (voir redeemAccessCode) — `read` aurait permis
      // à n'importe quel compte connecté de lister tous les codes actifs
      // et de les utiliser lui-même avant les destinataires prévus.
      allow get: if isSignedIn();
      allow create, delete: if isAdmin();
      // N'autorise que la décrémentation légitime de 1 d'un code actif —
      // jamais une réactivation, un reset, ou toucher un autre champ.
      allow update: if isSignedIn() &&
        resource.data.active == true &&
        resource.data.usesRemaining > 0 &&
        request.resource.data.usesRemaining == resource.data.usesRemaining - 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usesRemaining']);
    }

    match /suggestions/{suggestionId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Consultées et supprimées depuis l'écran Administration de l'app —
      // seul un compte admin y a accès, jamais l'auteur d'une suggestion ni
      // un autre utilisateur.
      allow read, delete: if isAdmin();
    }
  }
}
